{
  "name": "backend-butler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "dev": "vite build && tsx server/index.ts",
    "start": "node dist/server.mjs",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "typecheck": "tsc --noEmit",
    "build:card": "esbuild card/butler-quick-card.ts --bundle --format=esm --minify --target=es2022 --outfile=dist/card/butler-quick-card.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
